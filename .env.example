# LLM provider (required for agent runs)
# Supported: openai | groq | anthropic | ollama
LLM_PROVIDER=groq

# Groq (recommended for demo — fast inference, OpenAI-compatible API)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Groq base URL (used when LLM_PROVIDER=groq)
LLM_BASE_URL=https://api.groq.com/openai/v1

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514

# Ollama (local)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Orchestrator
WS_PORT=8765
SPECTRE_DATA_DIR=./data/sessions

# Logging
LOG_LEVEL=INFO
