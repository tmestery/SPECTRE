# LLM provider (required for agent runs)
# Supported: openai | groq | anthropic | ollama
LLM_PROVIDER=groq

# Groq (recommended for demo — fast inference, OpenAI-compatible API)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Groq base URL (used when LLM_PROVIDER=groq)
LLM_BASE_URL=https://api.groq.com/openai/v1

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514

# Ollama (local)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# GitHub (required for repo audits)
GITHUB_TOKEN=

# Orchestrator
WS_PORT=8765
WS_HOST=127.0.0.1
SPECTRE_DATA_DIR=./data/sessions
SCOPE_DIR=scopes

# Docker Compose / UI defaults (optional)
# SPECTRE_REPO=tmestery/SPECTRE
# SPECTRE_SCOPE=scopes/spectre.yaml
# SPECTRE_BRANCH=main
# SPECTRE_UI_PORT=8080
# VITE_WS_URL=ws://localhost:8765

# Logging
LOG_LEVEL=INFO

# Agent reasoning loop (LLM tool orchestration before subagent analysis)
# AGENT_REASONING_MAX_STEPS=6

# Advisory judging layer (Finding / Handoff / Report judges)
# JUDGES_ENABLED=true

# Handoff threshold profile for research A/B (default | strict)
# HANDOFF_PROFILE=default
# HANDOFF_PROFILES_DIR=handoff_profiles
